<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>マイページ - KAKERU</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/mystyle.css?v=20261016"></head><body><%@ include file="/include/header.jsp" %>
<main class="mypage-wrap">
 <section class="mypage-hero"><div class="mypage-avatar"><c:out value="${sessionScope.loginmember.nickname.substring(0,1)}"/></div><div><p class="section-label">MY ARCHIVE</p><h2><c:out value="${sessionScope.loginmember.nickname}"/>さんのデザインアーカイブ</h2><p>投稿した作品やフィードバック、お気に入りのデザインをまとめて管理できます。</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/blog/write">新しいデザインを投稿</a></section>
 <div class="mypage-stats"><div><strong>${myPosts.size()}</strong><span>投稿したデザイン</span></div><div><strong>${myReplies.size()}</strong><span>フィードバック</span></div><div><strong>${myLikes.size()}</strong><span>お気に入り</span></div></div>
 <div class="mypage-tabs" role="tablist"><button type="button" class="mypage-tab-btn active" data-tab="myPosts">投稿作品 <span>${myPosts.size()}</span></button><button type="button" class="mypage-tab-btn" data-tab="myReplies">フィードバック <span>${myReplies.size()}</span></button><button type="button" class="mypage-tab-btn" data-tab="myLikes">お気に入り <span>${myLikes.size()}</span></button></div>
 <section id="myPosts" class="mypage-panel active"><c:choose><c:when test="${empty myPosts}"><div class="mypage-empty"><b>まだ投稿したデザインはありません</b><p>最初のデザインをアーカイブに残してみましょう。</p><a class="btn btn-outline" href="${pageContext.request.contextPath}/blog/write">デザインを投稿</a></div></c:when><c:otherwise><ul class="mypage-card-grid"><c:forEach var="post" items="${myPosts}"><li class="mypage-design-card"><a href="${pageContext.request.contextPath}/blog/view?bno=${post.bno}"><div class="mypage-thumb"><c:choose><c:when test="${not empty post.imgPath}"><img src="${pageContext.request.contextPath}/imgs/${post.imgPath}" alt=""></c:when><c:otherwise><iframe class="design-preview" sandbox tabindex="-1" title="デザインプレビュー" srcdoc="<c:out value='${post.content}'/>"></iframe></c:otherwise></c:choose></div><div class="mypage-card-body"><b><c:out value="${post.title}"/></b><p>${post.regDate}<span>閲覧 ${post.viewCnt} · ♥ ${post.likeCnt}</span></p></div></a></li></c:forEach></ul></c:otherwise></c:choose></section>
 <section id="myReplies" class="mypage-panel"><c:choose><c:when test="${empty myReplies}"><div class="mypage-empty"><b>まだフィードバックはありません</b><p>気になるデザインにコメントしてみましょう。</p></div></c:when><c:otherwise><ul class="feedback-list"><c:forEach var="reply" items="${myReplies}"><li><span class="feedback-mark">“</span><div><p class="mypage-reply"><c:out value="${reply.content}"/></p><a class="mypage-title" href="${pageContext.request.contextPath}/blog/view?bno=${reply.bno}"><c:out value="${reply.boardTitle}"/></a><small>${reply.regDate}</small></div></li></c:forEach></ul></c:otherwise></c:choose></section>
 <section id="myLikes" class="mypage-panel"><c:choose><c:when test="${empty myLikes}"><div class="mypage-empty"><b>まだお気に入りはありません</b><p>また見たいデザインを集めてみましょう。</p></div></c:when><c:otherwise><ul class="mypage-card-grid"><c:forEach var="post" items="${myLikes}"><li class="mypage-design-card"><a href="${pageContext.request.contextPath}/blog/view?bno=${post.bno}"><div class="mypage-thumb"><c:choose><c:when test="${not empty post.imgPath}"><img src="${pageContext.request.contextPath}/imgs/${post.imgPath}" alt=""></c:when><c:otherwise><iframe class="design-preview" sandbox tabindex="-1" title="デザインプレビュー" srcdoc="<c:out value='${post.content}'/>"></iframe></c:otherwise></c:choose><span class="liked-mark">♥</span></div><div class="mypage-card-body"><b><c:out value="${post.title}"/></b><p>by <c:out value="${post.writerNickname}"/><span>♥ ${post.likeCnt}</span></p></div></a></li></c:forEach></ul></c:otherwise></c:choose></section>
</main><script src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script src="${pageContext.request.contextPath}/js/mypage.js"></script><%@ include file="/include/footer.jsp" %></body></html>
