<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>デザイン一覧 - KAKERU</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/mystyle.css?v=20261016"></head><body>
<%@ include file="/include/header.jsp" %>
<main class="list-wrap">
 <div class="page-heading"><p class="section-label">EXPLORE</p><h2>デザインを見つける</h2><p>クリエイターが共有したUIを、実際の表示でプレビューできます。</p></div>
 <div class="list-tools"><form class="search-form" action="${pageContext.request.contextPath}/blog/list" method="get"><select name="searchType" class="search-select" aria-label="検索条件"><option value="">検索条件</option><option value="title" ${searchType == 'title' ? 'selected' : ''}>タイトル</option><option value="content" ${searchType == 'content' ? 'selected' : ''}>内容</option><option value="writer" ${searchType == 'writer' ? 'selected' : ''}>投稿者</option></select><input type="text" name="keyword" value="<c:out value='${keyword}'/>" placeholder="気になるデザインを検索" class="search-input"><button type="submit" class="btn btn-outline">検索</button></form><a href="${pageContext.request.contextPath}/blog/write" class="btn btn-primary">デザインを投稿</a></div>
 <c:choose><c:when test="${not empty boardList}"><ul class="board-grid"><c:forEach var="b" items="${boardList}"><li class="board-card"><a class="board-card-link" href="${pageContext.request.contextPath}/blog/view?bno=${b.bno}"><div class="thumb-box"><c:choose><c:when test="${not empty b.imgPath}"><img src="${pageContext.request.contextPath}/imgs/${b.imgPath}" alt="デザインプレビュー" class="board-thumb"></c:when><c:otherwise><iframe class="design-preview" sandbox tabindex="-1" title="デザインプレビュー" srcdoc="<c:out value='${b.content}'/>"></iframe></c:otherwise></c:choose><span class="preview-badge">LIVE PREVIEW</span><span class="view-code">コードを見る</span></div><div class="board-info"><p class="board-title"><c:out value="${b.title}"/></p><p class="board-meta">by <c:out value="${b.writerNickname}"/> · <c:out value="${b.regDate}"/></p><p class="board-stat"><span>閲覧 <c:out value="${b.viewCnt}"/></span><span>♥ <c:out value="${b.likeCnt}"/></span></p></div></a></li></c:forEach></ul></c:when>
 <c:otherwise><section class="sample-section"><div class="sample-section-head"><span class="sample-pill">SAMPLE</span><h3>こんなデザインを共有できます</h3><p>最初の投稿前にご覧いただけるサンプルです。</p></div><ul class="board-grid sample-grid">
  <li class="board-card sample-post"><div class="thumb-box demo-gradient"><div class="demo-profile"><span>KR</span><b>Creative studio</b><small>Thoughtful digital experiences</small><button>View work</button></div><span class="preview-badge">PROFILE CARD</span></div><div class="board-info"><p class="board-title">グラデーションプロフィールカード</p><p class="board-meta">Glassmorphism · Profile</p></div></li>
  <li class="board-card sample-post"><div class="thumb-box demo-dashboard"><div class="demo-side"></div><div class="demo-chart"><b>Weekly activity</b><i></i><i></i><i></i><i></i><i></i></div><span class="preview-badge">DASHBOARD</span></div><div class="board-info"><p class="board-title">ミニマル分析ダッシュボード</p><p class="board-meta">Dashboard · Data UI</p></div></li>
  <li class="board-card sample-post"><div class="thumb-box demo-login"><div class="demo-login-card"><b>Welcome back</b><small>Sign in to continue</small><span>name@example.com</span><button>Sign in</button></div><span class="preview-badge">LOGIN UI</span></div><div class="board-info"><p class="board-title">やさしいログインフォーム</p><p class="board-meta">Form · Soft UI</p></div></li>
 </ul></section></c:otherwise></c:choose>
 <c:if test="${totalPages > 0}"><nav class="pagination" aria-label="ページナビゲーション">
  <c:url var="previousPageUrl" value="/blog/list"><c:param name="page" value="${startPage - 1}"/><c:param name="searchType" value="${searchType}"/><c:param name="keyword" value="${keyword}"/></c:url><c:if test="${startPage > 1}"><a class="page-link page-move" href="${previousPageUrl}">前へ</a></c:if>
  <c:forEach var="pageNo" begin="${startPage}" end="${endPage}"><c:url var="pageUrl" value="/blog/list"><c:param name="page" value="${pageNo}"/><c:param name="searchType" value="${searchType}"/><c:param name="keyword" value="${keyword}"/></c:url><a class="page-link ${pageNo == currentPage ? 'active' : ''}" href="${pageUrl}" aria-current="${pageNo == currentPage ? 'page' : 'false'}">${pageNo}</a></c:forEach>
  <c:url var="nextPageUrl" value="/blog/list"><c:param name="page" value="${endPage + 1}"/><c:param name="searchType" value="${searchType}"/><c:param name="keyword" value="${keyword}"/></c:url><c:if test="${endPage < totalPages}"><a class="page-link page-move" href="${nextPageUrl}">次へ</a></c:if>
 </nav></c:if>
</main><%@ include file="/include/footer.jsp" %></body></html>
