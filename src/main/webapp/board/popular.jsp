<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>人気デザイン - KAKERU</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/mystyle.css?v=20261016"></head><body>
<%@ include file="/include/header.jsp" %>
<main class="popular-wrap"><p class="section-label">MOST LOVED</p><h2 class="popular-page-title">人気デザイン</h2><p class="popular-sub">みんなが「いいね」したデザインをランキングでご紹介します。</p>
<c:choose><c:when test="${not empty poplist}"><ul class="popular-grid"><c:forEach var="b" items="${poplist}" varStatus="status"><li class="popular-card"><span class="rank-badge rank-${status.count}">${status.count}</span><a href="${pageContext.request.contextPath}/blog/view?bno=${b.bno}"><div class="thumb-box"><c:choose><c:when test="${not empty b.imgPath}"><img src="${pageContext.request.contextPath}/imgs/${b.imgPath}" alt="デザインプレビュー" class="popular-thumb"></c:when><c:otherwise><iframe class="design-preview" sandbox tabindex="-1" title="デザインプレビュー" srcdoc="<c:out value='${b.content}'/>"></iframe></c:otherwise></c:choose><span class="preview-badge">LIVE PREVIEW</span></div><div class="popular-info"><p class="popular-title"><c:out value="${b.title}"/></p><p class="popular-meta">by <c:out value="${b.writerNickname}"/> · ♥ <c:out value="${b.likeCnt}"/></p><p class="popular-meta">閲覧 <c:out value="${b.viewCnt}"/> · <c:out value="${b.regDate}"/></p></div></a></li></c:forEach></ul></c:when><c:otherwise><div class="popular-empty"><p>まだ投稿されたデザインはありません。</p><a class="btn btn-outline" href="${pageContext.request.contextPath}/blog/list">デザインを見る</a></div></c:otherwise></c:choose>
</main><%@ include file="/include/footer.jsp" %></body></html>
